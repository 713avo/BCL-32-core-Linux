# BCL-32 core (Linux) --- Makefile
# Builds the `bcl` interpreter. License: GPL-3.0-or-later (see LICENSE).

CC      ?= gcc
CFLAGS  ?= -Wall -Wextra -g
CFLAGS  += -MMD -MP -I./include
LDFLAGS += -lm -ldl -rdynamic

# readline is optional: used for line editing in the interactive session.
ifneq ($(wildcard /usr/include/readline/readline.h),)
CFLAGS  += -DHAVE_READLINE
LDFLAGS += -lreadline
endif

SRC_DIR = src
BIN_DIR = bin
SRCS = $(SRC_DIR)/main.c $(SRC_DIR)/bcl.c $(SRC_DIR)/lexer.c \
       $(SRC_DIR)/parser.c $(SRC_DIR)/eval.c $(SRC_DIR)/cmd.c \
       $(SRC_DIR)/evtsys.c $(SRC_DIR)/calc.c
OBJS = $(SRCS:$(SRC_DIR)/%.c=$(BIN_DIR)/%.o) $(BIN_DIR)/build_number.o
DEPS = $(OBJS:.o=.d)
TARGET = $(BIN_DIR)/bcl

# Installation: PREFIX rules everything; DESTDIR is for packagers.
#   make install                       -> /usr/local
#   make install PREFIX=$$HOME/.local
#   make install DESTDIR=/tmp/pkg PREFIX=/usr
PREFIX  ?= /usr/local
DESTDIR ?=
BINDIR  ?= $(PREFIX)/bin
DATADIR ?= $(PREFIX)/share/bcl
MAN_DIR ?= $(PREFIX)/share/man

.DEFAULT_GOAL := all
.PHONY: all clean rebuild install uninstall help

help:
	@echo "BCL-32 core --- targets"
	@echo "  make                 build bin/bcl"
	@echo "  make install         install into PREFIX (default /usr/local)"
	@echo "  make uninstall       remove the installed files"
	@echo "  make clean           remove build output"
	@echo
	@echo "Variables: PREFIX, DESTDIR, BINDIR, DATADIR, MAN_DIR, CC, CFLAGS"
	@echo "Current PREFIX=$(PREFIX)"

all: $(TARGET)

# Build number: the BUILD file (versioned) is bumped whenever the interpreter
# sources change, and shown by `bcl --version`.
$(BIN_DIR)/build_number.c: $(SRCS) $(wildcard include/*.h)
	@mkdir -p $(BIN_DIR)
	@n=$$(cat BUILD 2>/dev/null || echo 0); n=$$((n+1)); echo $$n > BUILD; \
	  printf '/* Generated by make: do not edit. */\nint bcl_build_number(void) { return %s; }\n' $$n > $@; \
	  echo "BCL-32 build $$n"

$(BIN_DIR)/build_number.o: $(BIN_DIR)/build_number.c
	$(CC) $(CFLAGS) -c $< -o $@

$(BIN_DIR)/%.o: $(SRC_DIR)/%.c
	@mkdir -p $(BIN_DIR)
	$(CC) $(CFLAGS) -c $< -o $@

$(TARGET): Makefile $(OBJS)
	$(CC) $(OBJS) -o $@ $(LDFLAGS)

clean:
	rm -f $(BIN_DIR)/*.o $(BIN_DIR)/*.d $(BIN_DIR)/build_number.c $(TARGET)
	-rmdir $(BIN_DIR)

rebuild: clean all

install: all
	install -d $(DESTDIR)$(BINDIR)
	install -m 755 $(TARGET) $(DESTDIR)$(BINDIR)/
	install -d $(DESTDIR)$(MAN_DIR)/man1 $(DESTDIR)$(MAN_DIR)/es/man1
	install -m 644 man/bcl.1 $(DESTDIR)$(MAN_DIR)/man1/
	install -m 644 man/es/bcl.1 $(DESTDIR)$(MAN_DIR)/es/man1/
	install -d $(DESTDIR)$(DATADIR)/examples $(DESTDIR)$(DATADIR)/doc
	install -m 644 examples/*.bcl $(DESTDIR)$(DATADIR)/examples/
	install -m 644 doc/*.md $(DESTDIR)$(DATADIR)/doc/
	install -m 644 LICENSE $(DESTDIR)$(DATADIR)/
	@echo "Installed in $(DESTDIR)$(PREFIX)"

uninstall:
	rm -f $(DESTDIR)$(BINDIR)/bcl
	rm -f $(DESTDIR)$(MAN_DIR)/man1/bcl.1 $(DESTDIR)$(MAN_DIR)/es/man1/bcl.1
	rm -f $(DESTDIR)$(DATADIR)/examples/*.bcl $(DESTDIR)$(DATADIR)/doc/*.md $(DESTDIR)$(DATADIR)/LICENSE
	-rmdir $(DESTDIR)$(DATADIR)/examples $(DESTDIR)$(DATADIR)/doc $(DESTDIR)$(DATADIR)
	-rmdir $(DESTDIR)$(MAN_DIR)/es/man1 $(DESTDIR)$(MAN_DIR)/es
	@echo "Removed from $(DESTDIR)$(PREFIX)"

-include $(DEPS)
